---
/**
 * Gate hero: the view from the flight deck at dawn — windscreen full-bleed down to the
 * glareshield. The name sits on the HUD, the pitch on the centre display. Two drawings
 * share one stage — wide (1440×900) and tall (390×844) — scaled to cover the viewport;
 * flight.ts scrubs the push through the windscreen and boots the HUD readouts.
 * Instrument values are the readout's gate state plus the base's coordinates and the
 * flight plan from flightplan.ts; nothing else on the panel makes a claim.
 */
import { route } from '../../data/flightplan';

interface Props {
  name: string;
  pitch: string;
}
const { name, pitch } = Astro.props;
const [first, ...rest] = name.split(' ');

const r1 = (n: number) => Math.round(n * 10) / 10;
const at = (cx: number, cy: number, r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return `${r1(cx + r * Math.sin(a))} ${r1(cy - r * Math.cos(a))}`;
};
const HAIR = 'rgba(232,237,245,.14)';

/* ─── HUD data: the base's coordinates and the flight plan (flightplan.ts) ─── */
const base = route[route.length - 1];
const coord = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(2)} ${v >= 0 ? pos : neg}`;
const LAT = `LAT ${coord(base.lat, 'N', 'S')}`;
const LON = `LON ${coord(base.lon, 'E', 'W')}`;
const FPLN = `FPLN ${route.map((c) => c.code).join(' ')}`;

/* ─── the view: a runway running out into fog, its lights glowing through it. Fog tones are mixes of the
   dawn sky and ink (#dde6ee × #0b1020); the lights are the dusk warm (#f2a36b). All static SVG — gradients,
   no filters — so nothing in it repaints while the page moves. ─── */
function view(p: string, w: number, h: number, hz: number, vx: number, bot: number, half: number): string {
  const big = w > 800;
  const k = (y: number) => (y - hz) / (bot - hz); // perspective: 0 at the horizon, 1 at `bot`
  const rowY = (d: number) => hz + (bot - hz) / d; // screen row of the runway `d` units ahead
  const X = (lat: number, y: number) => vx + lat * half * k(y); // lateral: -1 left edge … 1 right edge
  const poly = (ps: number[][]) => ps.map(([x, y]) => `${r1(x)},${r1(y)}`).join(' ');
  const top = hz + 0.5;
  /** a line painted along the runway at `lat`, `bw` wide where k = 1, tapering into the vanishing point */
  const strip = (lat: number, bw: number) => poly([[X(lat, top), top], [X(lat, h) + bw * k(h), h], [X(lat, h) - bw * k(h), h]]);
  /** the surface between two lateral positions, horizon to bottom edge */
  const band = (a: number, b: number) => poly([[X(a, top), top], [X(b, top), top], [X(b, h), h], [X(a, h), h]]);

  const FAR = 3.4; // where the fog swallows the runway — the threshold lights sit on this row
  const yFar = rowY(FAR);

  const joints = [0.55, 0.62, 0.7, 0.8, 0.92, 1.06, 1.22, 1.42, 1.66, 1.95, 2.3, 2.75, 3.3, 4]
    .map((d) => {
      const y = rowY(d);
      return y > h ? '' : `<line x1="${r1(X(-1, y))}" y1="${r1(y)}" x2="${r1(X(1, y))}" y2="${r1(y)}" stroke-width="${r1(Math.max(0.4, (big ? 1.6 : 0.8) / d))}"/>`;
    }).join('');
  const seams = [-0.72, -0.2, 0.2, 0.72].map((lat) => `<line x1="${vx}" y1="${top}" x2="${r1(X(lat, h))}" y2="${h}"/>`).join('');
  const dashes: string[] = [];
  for (let d = 0.55; d < 7; d += 0.5) {
    const cb = big ? 4.5 : 2, y1 = Math.min(rowY(d), h), y2 = rowY(d + 0.22);
    if (y2 > h) continue;
    dashes.push(`<polygon points="${poly([[vx - cb * k(y1), y1], [vx + cb * k(y1), y1], [vx + cb * k(y2), y2], [vx - cb * k(y2), y2]])}"/>`);
  }
  const warm = [-0.42, 0.42].map((lat) =>
    `<polygon points="${strip(lat, big ? 26 : 11)}" fill="#f2a36b" opacity=".07"/>` +
    `<polygon points="${strip(lat, big ? 10 : 4.5)}" fill="#f2a36b" opacity=".22"/>` +
    `<polygon points="${strip(lat, big ? 3.4 : 1.5)}" fill="#f9d2a6" opacity=".95"/>`).join('');

  /** a point light: core, round halo, and the long horizontal flare a lens gives it */
  const glint = (x: number, y: number, r: number, a: number) =>
    `<ellipse cx="${r1(x)}" cy="${r1(y)}" rx="${r1(r * 9)}" ry="${r1(r * 0.9)}" fill="url(#${p}-halo)" opacity="${r1(a * 0.55)}"/>` +
    `<circle cx="${r1(x)}" cy="${r1(y)}" r="${r1(r * 5)}" fill="url(#${p}-halo)" opacity="${r1(a)}"/>` +
    `<circle cx="${r1(x)}" cy="${r1(y)}" r="${r1(r)}" fill="#fff4e6" opacity="${r1(a)}"/>`;
  const glints = [1.6, 2.2].flatMap((d) => {
    const y = rowY(d), r = (big ? 2.2 : 1) * k(y) + (big ? 0.8 : 0.4), a = Math.min(1, 1.6 / d);
    return [-0.42, 0.42].map((lat) => glint(X(lat, y), y, r, a));
  }).join('');
  const threshold = [-1, 1].map((side) =>
    `<ellipse cx="${r1(X(side * 0.41, yFar))}" cy="${r1(yFar)}" rx="${big ? 96 : 30}" ry="${big ? 20 : 7}" fill="url(#${p}-halo)" opacity=".75"/>` +
    [0.32, 0.38, 0.44, 0.5].map((lat) => glint(X(side * lat, yFar), yFar, big ? 1.5 : 0.7, 0.9)).join('')).join('');

  // fog: opaque at the horizon, gone by d = 2.4, so the near runway under the name stays crisp and only the distance fades
  const fTop = hz - (big ? 40 : 18), fBot = rowY(2.4), span = fBot - fTop;
  const off = (y: number) => ((y - fTop) / span).toFixed(3);
  const farLine = rowY(2.6);

  return `<defs>
<linearGradient id="${p}-sky" x1="0" y1="0" x2="0" y2="${hz}" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#8d95a0"/><stop offset=".65" stop-color="#7a828d"/><stop offset="1" stop-color="#848c97"/></linearGradient>
<linearGradient id="${p}-ground" x1="0" y1="${hz}" x2="0" y2="${h}" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#4a505b"/><stop offset=".3" stop-color="#262b36"/><stop offset="1" stop-color="#141822"/></linearGradient>
<linearGradient id="${p}-asphalt" x1="0" y1="${hz}" x2="0" y2="${h}" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#3c424d"/><stop offset=".45" stop-color="#2c313b"/><stop offset="1" stop-color="#1e222b"/></linearGradient>
<linearGradient id="${p}-fog" x1="0" y1="${fTop}" x2="0" y2="${r1(fBot)}" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#848c97" stop-opacity="0"/><stop offset="${off(hz)}" stop-color="#80888f" stop-opacity=".97"/><stop offset="${off(yFar)}" stop-color="#7a828d" stop-opacity=".7"/><stop offset="1" stop-color="#6f7782" stop-opacity="0"/></linearGradient>
<radialGradient id="${p}-halo"><stop offset="0" stop-color="#fbd9b0" stop-opacity=".95"/><stop offset=".3" stop-color="#f2a36b" stop-opacity=".4"/><stop offset="1" stop-color="#f2a36b" stop-opacity="0"/></radialGradient>
</defs>
<rect width="${w}" height="${hz + 2}" fill="url(#${p}-sky)"/>
<rect y="${hz}" width="${w}" height="${h - hz}" fill="url(#${p}-ground)"/>
<polygon points="${band(-1.03, 1.03)}" fill="url(#${p}-asphalt)"/>
<polygon points="${band(-0.28, -0.07)}" fill="#000" opacity=".14"/><polygon points="${band(0.07, 0.28)}" fill="#000" opacity=".14"/>
<g stroke="#000" stroke-opacity=".28" stroke-width="${big ? 1.2 : 0.6}">${seams}</g>
<g stroke="#000" stroke-opacity=".3">${joints}</g>
<polygon points="${strip(-0.97, big ? 2.4 : 1.1)}" fill="#e8edf5" opacity=".36"/><polygon points="${strip(0.97, big ? 2.4 : 1.1)}" fill="#e8edf5" opacity=".36"/>
<g fill="#e8edf5" opacity=".78">${dashes.join('')}</g>
<line x1="${r1(X(-0.42, farLine))}" y1="${r1(farLine)}" x2="${r1(X(0.42, farLine))}" y2="${r1(farLine)}" stroke="#e8edf5" stroke-opacity=".5" stroke-width="${big ? 1.6 : 0.8}"/>
${warm}
<rect y="${fTop}" width="${w}" height="${r1(span)}" fill="url(#${p}-fog)"/>
<ellipse cx="${vx}" cy="${r1(yFar)}" rx="${big ? 420 : 170}" ry="${big ? 70 : 30}" fill="url(#${p}-halo)" opacity=".28"/>
${threshold}${glints}`;
}

/* ─── HUD symbology: horizon, one pitch rung, flight-path marker, flight-plan inset ─── */
const fpm = (x: number, y: number, s: number) =>
  `<g transform="translate(${x} ${y}) scale(${s})" stroke="#7fd3ff" stroke-width="2.4" fill="none" stroke-linecap="round"><circle r="7"/><path d="M-7 0H-24M7 0H24M0-7V-17"/></g>`;

/* the flight plan on real geography (same window as the route map), drawn on when the HUD boots */
const LABEL: Record<string, [number, number, 'start' | 'end']> = {
  MAA: [10, 17, 'start'], BLR: [-10, 5, 'end'], BOM: [-10, -7, 'end'], ICN: [10, -7, 'start'], LYS: [10, -7, 'start'],
};
function inset(x: number, y: number, s: number): string {
  const pt = (c: (typeof route)[number]) => [((c.lon + 15) / 160) * 300, ((65 - c.lat) / 70) * 130];
  const pts = route.map(pt);
  const line = 'M ' + pts.map(([px, py]) => `${r1(px)} ${r1(py)}`).join(' L ');
  const star = (cx: number, cy: number) =>
    `M ${r1(cx)} ${r1(cy - 5)} L ${r1(cx + 1.7)} ${r1(cy - 1.7)} L ${r1(cx + 5)} ${r1(cy)} L ${r1(cx + 1.7)} ${r1(cy + 1.7)} L ${r1(cx)} ${r1(cy + 5)} L ${r1(cx - 1.7)} ${r1(cy + 1.7)} L ${r1(cx - 5)} ${r1(cy)} L ${r1(cx - 1.7)} ${r1(cy - 1.7)} Z`;
  const wps = route.map((c, i) => {
    const [px, py] = pts[i], [dx, dy, anchor] = LABEL[c.code] ?? [10, -7, 'start'];
    return `<g class="wp" style="--i: ${i}"><path d="${star(px, py)}" fill="#e8edf5"/><text x="${r1(px + dx)}" y="${r1(py + dy)}" text-anchor="${anchor}">${c.code}</text></g>`;
  }).join('');
  return `<g class="deck__route" transform="translate(${x} ${y}) scale(${s})" font-size="11" fill="#7fd3ff" letter-spacing="1">
<path class="deck__route-line" d="${line}" pathLength="1" fill="none" stroke="#7fd3ff" stroke-width="1.6" stroke-dasharray="1" stroke-dashoffset="1"/>${wps}</g>`;
}
const wideSym = `<g class="deck__hzn" stroke="#7fd3ff" stroke-width="1.6" fill="none" opacity=".85"><path d="M 380 330 H 668 M 772 330 H 1060"/><path d="M 604 250 H 668 V 258 M 836 250 H 772 V 258"/></g>${fpm(720, 330, 1.25)}${inset(1076, 196, 1)}`;
/* tall: the horizon sits higher (210 of 844) so the sky doesn't dominate a phone screen */
const tallSym = `<g class="deck__hzn" stroke="#7fd3ff" stroke-width="1.4" fill="none" opacity=".85"><path d="M 44 210 H 170 M 220 210 H 346"/><path d="M 140 154 H 176 V 160 M 250 154 H 214 V 160"/></g>${fpm(195, 210, 0.95)}${inset(244, 98, 0.45)}`;

/* ─── cockpit hardware ─── */
function defs(p: string): string {
  return `<defs>
<linearGradient id="${p}-top" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1b2a4e"/><stop offset="1" stop-color="#0b1020"/></linearGradient>
<linearGradient id="${p}-shade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#070b1a" stop-opacity=".85"/><stop offset="1" stop-color="#070b1a" stop-opacity="0"/></linearGradient>
<linearGradient id="${p}-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8edf5" stop-opacity=".08"/><stop offset=".4" stop-color="#e8edf5" stop-opacity="0"/></linearGradient>
<radialGradient id="${p}-knob" cx=".38" cy=".32" r=".75"><stop offset="0" stop-color="#1b2a4e"/><stop offset="1" stop-color="#070b1a"/></radialGradient>
</defs>`;
}
const knob = (cx: number, cy: number, r: number, p: string) =>
  `<circle cx="${cx}" cy="${cy}" r="${r}" fill="url(#${p}-knob)" stroke="rgba(232,237,245,.22)"/><line x1="${cx}" y1="${cy}" x2="${cx}" y2="${r1(cy - r + 3)}" stroke="#e8edf5" stroke-width="1.5" opacity=".7"/>`;
const button = (x: number, y: number, w: number, h: number, lit: boolean, label = '') =>
  `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="2" fill="#0b1020" stroke="${HAIR}"/><rect x="${x + 4}" y="${y + h - 4}" width="${w - 8}" height="2" fill="${lit ? '#7fd3ff' : 'rgba(232,237,245,.16)'}"/>` +
  (label ? `<text x="${x + w / 2}" y="${y + 8}" font-size="6" text-anchor="middle" fill="rgba(232,237,245,.7)">${label}</text>` : '');
const toggle = (x: number, y: number) =>
  `<rect x="${x - 5}" y="${y - 8}" width="10" height="16" rx="3" fill="#070b1a" stroke="${HAIR}"/><line x1="${x}" y1="${y}" x2="${x}" y2="${y - 7}" stroke="#e8edf5" stroke-width="2" stroke-linecap="round" opacity=".7"/>`;
const fastener = ([x, y]: number[]) =>
  `<circle cx="${x}" cy="${y}" r="3.2" fill="#0b1020" stroke="rgba(232,237,245,.18)"/><line x1="${x - 2}" y1="${y + 1.4}" x2="${x + 2}" y2="${y - 1.4}" stroke="rgba(232,237,245,.3)"/>`;
const wiper = (px: number, py: number, tx: number, ty: number) =>
  `<g stroke-linecap="round"><line x1="${px}" y1="${py}" x2="${tx}" y2="${ty}" stroke="#070b1a" stroke-width="5"/><line x1="${r1(px + (tx - px) * 0.3)}" y1="${r1(py + (ty - py) * 0.3 - 3)}" x2="${tx}" y2="${ty - 3}" stroke="#0b1020" stroke-width="2.5"/><circle cx="${px}" cy="${py}" r="7" fill="#0b1020" stroke="${HAIR}"/></g>`;

/** display unit: bezel, screen, content, glass glare, corner screws; `i` orders the power-on sequence */
function du(x: number, y: number, w: number, h: number, b: number, p: string, content: string, i: number): string {
  const bx = x - b, by = y - b, bw = w + 2 * b, bh = h + 2 * b;
  const screws = [[bx + 4.5, by + 4.5], [bx + bw - 4.5, by + 4.5], [bx + 4.5, by + bh - 4.5], [bx + bw - 4.5, by + bh - 4.5]]
    .map(([sx, sy]) => `<circle cx="${sx}" cy="${sy}" r="1.6" fill="rgba(232,237,245,.25)"/>`).join('');
  return `<rect x="${bx}" y="${by}" width="${bw}" height="${bh}" rx="6" fill="#0b1020" stroke="rgba(232,237,245,.12)"/>
<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="2" fill="#070b1a"/>
<g class="du" style="--i: ${i}">${content}<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="2" fill="url(#${p}-glass)"/></g>${screws}`;
}

/** primary flight display at the gate: level attitude, empty tapes (drawn on a 200-unit grid) */
function pfd(clip: string, x: number, y: number, s: number): string {
  const ticks = (x0: number, dir: number) =>
    Array.from({ length: 10 }, (_, i) => `<line x1="${x0}" y1="${34 + i * 12}" x2="${x0 + dir * (i % 2 ? 5 : 10)}" y2="${34 + i * 12}"/>`).join('');
  const bank = [-45, -30, -20, -10, 0, 10, 20, 30, 45].map((a) => `<path d="M ${at(100, 94, 58, a)} L ${at(100, 94, a % 30 === 0 || a === 0 ? 66 : 62, a)}"/>`).join('');
  const hdg = Array.from({ length: 13 }, (_, i) => `<line x1="${46 + i * 9}" y1="176" x2="${46 + i * 9}" y2="${i % 2 ? 172 : 168}"/>`).join('');
  return `<g transform="translate(${x} ${y}) scale(${s})">
<clipPath id="${clip}"><rect x="40" y="28" width="120" height="120" rx="12"/></clipPath>
<g clip-path="url(#${clip})"><g class="pfd-att"><rect x="40" y="28" width="120" height="66" fill="#7fa8cc"/><rect x="40" y="94" width="120" height="54" fill="#3a2140"/>
<line x1="40" y1="94" x2="160" y2="94" stroke="#e8edf5" stroke-width="1.5"/>
<g stroke="#e8edf5" opacity=".85"><line x1="88" y1="80" x2="112" y2="80"/><line x1="80" y1="66" x2="120" y2="66"/><line x1="88" y1="108" x2="112" y2="108"/><line x1="80" y1="122" x2="120" y2="122"/></g></g></g>
<g stroke="#e8edf5" stroke-width="1.5" fill="none"><path d="M ${at(100, 94, 58, -45)} A 58 58 0 0 1 ${at(100, 94, 58, 45)}"/>${bank}</g>
<polygon points="100,38 95,46 105,46" fill="#e8edf5"/>
<path d="M 62 94 H 84 V 101 M 138 94 H 116 V 101" stroke="#ff7a2f" stroke-width="4" fill="none"/><rect x="97" y="91" width="6" height="6" fill="#ff7a2f"/>
<rect x="8" y="28" width="26" height="120" fill="rgba(232,237,245,.08)"/><rect x="166" y="28" width="26" height="120" fill="rgba(232,237,245,.08)"/>
<g stroke="rgba(232,237,245,.6)">${ticks(34, -1)}${ticks(166, 1)}${hdg}</g>
<polygon points="34,88 41,94 34,100" fill="#7fd3ff"/><polygon points="166,88 159,94 166,100" fill="#7fd3ff"/>
<line x1="46" y1="176" x2="154" y2="176" stroke="rgba(232,237,245,.5)"/><polygon points="100,170 95,162 105,162" fill="#e8edf5"/>
</g>`;
}

/** navigation display, arc mode: compass arc, range ring, route ahead (drawn on a 200-unit grid) */
function nd(x: number, y: number, s: number): string {
  const ticks = Array.from({ length: 17 }, (_, i) => -48 + i * 6)
    .map((a) => `<path d="M ${at(100, 180, 132, a)} L ${at(100, 180, a % 30 === 0 ? 118 : 125, a)}"/>`).join('');
  const star = (cx: number, cy: number) =>
    `<path d="M ${cx} ${cy - 6} L ${cx + 2} ${cy - 2} L ${cx + 6} ${cy} L ${cx + 2} ${cy + 2} L ${cx} ${cy + 6} L ${cx - 2} ${cy + 2} L ${cx - 6} ${cy} L ${cx - 2} ${cy - 2} Z" fill="#e8edf5"/>`;
  return `<g transform="translate(${x} ${y}) scale(${s})">
<g stroke="#e8edf5" stroke-width="1.5" fill="none"><path d="M ${at(100, 180, 132, -48)} A 132 132 0 0 1 ${at(100, 180, 132, 48)}"/>${ticks}</g>
<path d="M ${at(100, 180, 70, -48)} A 70 70 0 0 1 ${at(100, 180, 70, 48)}" stroke="rgba(232,237,245,.35)" stroke-dasharray="4 5" fill="none"/>
<polyline points="100,170 100,110 146,62" stroke="#7fd3ff" stroke-width="2" stroke-dasharray="7 5" fill="none"/>${star(100, 110)}${star(146, 62)}
<polygon points="100,40 95,32 105,32" fill="#e8edf5"/><polygon points="100,166 93,186 100,181 107,186" fill="#e8edf5"/>
</g>`;
}

/** analogue standby gauge; the needle drifts (strato-live.css) */
function standby(cx: number, cy: number, r: number): string {
  const ticks = Array.from({ length: 12 }, (_, i) => `<path d="M ${at(cx, cy, r - 3, i * 30)} L ${at(cx, cy, r - (i % 3 ? 6 : 9), i * 30)}"/>`).join('');
  return `<circle cx="${cx}" cy="${cy}" r="${r + 5}" fill="#0b1020" stroke="${HAIR}"/><circle cx="${cx}" cy="${cy}" r="${r}" fill="#070b1a" stroke="rgba(232,237,245,.16)"/>
<g stroke="rgba(232,237,245,.55)">${ticks}</g><g class="sb-needle" style="transform-origin: ${cx}px ${cy}px"><path d="M ${cx} ${cy} L ${at(cx, cy, r - 7, -40)}" stroke="#e8edf5" stroke-width="2" stroke-linecap="round"/></g><circle cx="${cx}" cy="${cy}" r="2.5" fill="#1b2a4e"/>`;
}

/* ─── wide stage (1440 × 900) ─── */
const W = 'dkw';
const lbl = (x: number, t: string) => `<text x="${x}" y="588.5" font-size="8" fill="rgba(232,237,245,.62)">${t}</text>`;
const win = (x: number, w: number, t: string, color: string, mid = false) =>
  `<rect x="${x}" y="592" width="${w}" height="22" rx="2" fill="#070b1a" stroke="rgba(232,237,245,.1)"/><text x="${mid ? x + w / 2 : x + w - 8}" y="607.5" font-size="${mid ? 11 : 12.5}" fill="${color}" text-anchor="${mid ? 'middle' : 'end'}">${t}</text>`;
const efis = (x0: number) =>
  `<rect x="${x0}" y="586" width="204" height="40" rx="3" fill="#1b2a4e" opacity=".7" stroke="${HAIR}"/>${knob(x0 + 24, 606, 10, W)}` +
  [0, 1, 2, 3].map((i) => button(x0 + 48 + i * 27, 598, 22, 16, i === 0)).join('') + knob(x0 + 180, 606, 10, W);
const caution = (x: number) =>
  `<rect x="${x}" y="592" width="30" height="26" rx="2" fill="rgba(255,122,47,.14)" stroke="rgba(255,122,47,.5)"/><text x="${x + 15}" y="608" font-size="6.5" text-anchor="middle" fill="rgba(255,122,47,.75)">CAUT</text>`;

const wideView = view(W, 1440, 900, 330, 720, 640, 600);
const wideFrame = `${defs(W)}
${wiper(430, 548, 612, 520)}${wiper(1010, 548, 828, 520)}
<rect y="560" width="1440" height="340" fill="#0b1020"/><rect y="560" width="1440" height="340" fill="#1b2a4e" opacity=".42"/>
<g stroke="#070b1a" stroke-width="2"><line x1="478" y1="600" x2="478" y2="900"/><line x1="962" y1="600" x2="962" y2="900"/><line x1="0" y1="868" x2="1440" y2="868"/></g>
<g stroke="rgba(232,237,245,.06)"><line x1="480" y1="600" x2="480" y2="900"/><line x1="964" y1="600" x2="964" y2="900"/><line x1="0" y1="870" x2="1440" y2="870"/></g>
${du(40, 652, 200, 200, 10, W, pfd(`${W}-a1`, 40, 652, 1), 0)}
${du(264, 652, 200, 200, 10, W, nd(264, 652, 1), 1)}
${du(492, 652, 456, 200, 10, W, '', 2)}
${du(976, 652, 200, 200, 10, W, nd(976, 652, 1), 3)}
${du(1200, 652, 200, 200, 10, W, pfd(`${W}-a2`, 1200, 652, 1), 4)}
${[40, 264, 976, 1200].map((x) => toggle(x + 16, 885) + knob(x + 186, 884, 7, W)).join('')}
${Array.from({ length: 6 }, (_, i) => button(601 + i * 42, 877, 28, 14, i === 1 || i === 4)).join('')}
${[[16, 640], [16, 888], [1424, 640], [1424, 888], [470, 888], [970, 888]].map(fastener).join('')}
<rect y="600" width="1440" height="80" fill="url(#${W}-shade)"/>
<path d="M 0 546 Q 720 520 1440 546 L 1440 596 Q 720 572 0 596 Z" fill="url(#${W}-top)"/>
<path d="M 0 546 Q 720 520 1440 546" fill="none" stroke="rgba(221,230,238,.22)" stroke-width="1.5"/>
<path d="M 0 596 Q 720 572 1440 596 L 1440 634 Q 720 612 0 634 Z" fill="#0b1020"/>
<path d="M 0 596 Q 720 572 1440 596" fill="none" stroke="rgba(232,237,245,.1)"/>
<rect x="476" y="578" width="488" height="50" rx="3" fill="#1b2a4e" stroke="rgba(232,237,245,.16)"/>
<g class="du" style="--i: 2.5">${lbl(500, 'MACH')}${win(500, 88, '0.00', '#7fd3ff')}${knob(612, 603, 11, W)}
${button(640, 594, 24, 18, true, 'AP1')}${button(669, 594, 24, 18, true, 'AP2')}${button(698, 594, 30, 18, false, 'A/THR')}
${lbl(744, 'ALT')}${win(744, 104, '00,000', '#7fd3ff')}${knob(872, 603, 11, W)}
${lbl(896, 'WPT')}${win(896, 58, 'GATE', '#ff7a2f', true)}</g>
${efis(96)}${caution(316)}${efis(1140)}${caution(1094)}`;

/* ─── tall stage (390 × 844) ─── */
const T = 'dkt';
const winT = (x: number, w: number, t: string, color: string, mid = false) =>
  `<rect x="${x}" y="477" width="${w}" height="16" rx="2" fill="#070b1a" stroke="rgba(232,237,245,.1)"/><text x="${mid ? x + w / 2 : x + w - 6}" y="488.5" font-size="${mid ? 8.5 : 10}" fill="${color}" text-anchor="${mid ? 'middle' : 'end'}">${t}</text>`;
const tallView = view(T, 390, 844, 210, 195, 520, 150);
const tallFrame = `${defs(T)}
${wiper(96, 452, 214, 434)}
<rect y="462" width="390" height="382" fill="#0b1020"/><rect y="462" width="390" height="382" fill="#1b2a4e" opacity=".42"/>
${du(30, 530, 330, 184, 8, T, '', 1)}
${du(40, 746, 84, 84, 7, T, pfd(`${T}-a1`, 40, 746, 0.42), 0)}
${du(266, 746, 84, 84, 7, T, nd(266, 746, 0.42), 2)}
${standby(166, 788, 22)}${standby(224, 788, 22)}
${[[12, 520], [378, 520], [12, 834], [378, 834]].map(fastener).join('')}
<rect y="494" width="390" height="60" fill="url(#${T}-shade)"/>
<path d="M 0 448 Q 195 436 390 448 L 390 474 Q 195 464 0 474 Z" fill="url(#${T}-top)"/>
<path d="M 0 448 Q 195 436 390 448" fill="none" stroke="rgba(221,230,238,.22)"/>
<path d="M 0 474 Q 195 464 390 474 L 390 502 Q 195 494 0 502 Z" fill="#0b1020"/>
<rect x="60" y="470" width="270" height="30" rx="3" fill="#1b2a4e" stroke="rgba(232,237,245,.16)"/>
<g class="du" style="--i: 1.5">${winT(72, 56, '0.00', '#7fd3ff')}${knob(140, 485, 7, T)}${winT(156, 70, '00,000', '#7fd3ff')}${knob(238, 485, 7, T)}${winT(254, 66, 'GATE', '#ff7a2f', true)}</g>`;

/* fog banks straddling the horizon (stage units: x, width, height, rise above the horizon, drift phase) */
const wideClouds = [[-80, 700, 64, 22, '0s'], [520, 560, 52, 10, '-32s'], [980, 640, 70, 30, '-58s']];
const tallClouds = [[-60, 300, 30, 10, '0s'], [120, 240, 24, 4, '-38s'], [240, 280, 32, 16, '-60s']];
const cloud = ([x, w, h, dy, d]: (number | string)[]) => `--x: ${x}; --w: ${w}; --h: ${h}; --dy: ${dy}; animation-delay: ${d}`;
---

<section class="leg deck phase-dawn" data-leg="gate" id="gate" aria-labelledby="hero-name">
  <div class="deck__clip">
    <div class="deck__stage">
      <div class="deck__art deck__art--wide" aria-hidden="true">
        <div class="deck__view">
          <svg viewBox="0 0 1440 900" preserveAspectRatio="none" set:html={wideView} />
          <i class="deck__glow"></i>
          {wideClouds.map((c) => <i class="deck__cloud" style={cloud(c)}></i>)}
        </div>
        <svg class="deck__frame" viewBox="0 0 1440 900" preserveAspectRatio="none" set:html={wideFrame} />
      </div>
      <div class="deck__art deck__art--tall" aria-hidden="true">
        <div class="deck__view">
          <svg viewBox="0 0 390 844" preserveAspectRatio="none" set:html={tallView} />
          <i class="deck__glow"></i>
          {tallClouds.map((c) => <i class="deck__cloud" style={cloud(c)}></i>)}
        </div>
        <svg class="deck__frame" viewBox="0 0 390 844" preserveAspectRatio="none" set:html={tallFrame} />
      </div>
      <div class="deck__hud">
        <svg class="deck__sym deck__sym--wide" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true" set:html={wideSym} />
        <svg class="deck__sym deck__sym--tall" viewBox="0 0 390 844" preserveAspectRatio="none" aria-hidden="true" set:html={tallSym} />
        <div class="deck__data deck__data--l mono" aria-hidden="true">
          <span data-boot={LAT}>{LAT}</span><span data-boot={LON}>{LON}</span><span data-boot="GS 000 KT">GS 000 KT</span>
        </div>
        <div class="deck__data deck__data--r mono" aria-hidden="true">
          <span data-boot={FPLN}>{FPLN}</span><span data-boot="STATUS READY">STATUS READY</span>
        </div>
        <h1 id="hero-name" class="deck__name"><span>{first}</span> <span>{rest.join(' ')}</span></h1>
        <a class="deck__enter mono" href="#about"><b>[</b> Enter flight log <i aria-hidden="true">↓</i> <b>]</b></a>
      </div>
      <div class="deck__screen"><p class="deck__pitch">{pitch}</p></div>
    </div>
  </div>
</section>
