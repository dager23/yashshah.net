---
/**
 * /hangar — the lower ECAM display.
 *
 * One page per system, cycled by the button row underneath, the way an aircraft
 * cycles ENG / BLEED / HYD. Each page carries the synoptic (what the thing
 * actually does), a demo you can press, and readouts whose figures all come from
 * the project itself — see the house rule at the top of src/data/hangar.ts.
 *
 * The synoptic takes the full width of the display: the drawings are 640 units
 * wide and clip rather than shrink, so they never share a row with the demo.
 *
 * Progressive enhancement: with JavaScript off every page is simply stacked and
 * the status table's links are ordinary in-page anchors.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Strato from '../../layouts/Strato.astro';
import { systems, stateLabel } from '../../data/hangar';
import { synoptics } from '../../components/strato/syn/diagrams';
import { defs } from '../../components/strato/syn/parts';
import '../../styles/strato-hangar.css';

/** screenshots are optional: a missing file degrades to the synoptic, never a broken build */
const media = import.meta.glob<{ default: ImageMetadata }>('../../assets/hangar/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const shot = (file: string): ImageMetadata | undefined => media[`../../assets/hangar/${file}`]?.default;

/** a console line is either the command, an error, or ordinary output */
const lineClass = (l: string) =>
  l.startsWith('$') ? 'demo__cmd' : /\berror\b/.test(l) ? 'demo__err' : 'demo__dim';

const tabs = [{ slug: 'status', ident: 'STATUS' }, ...systems.map((s) => ({ slug: s.slug, ident: s.ident }))];
---

<Strato
  path="/hangar"
  title="Hangar"
  description="Everything I've built that can be demonstrated — drawn as aircraft system pages: doc-drift and agent-governance tooling, a scam guardian, a live signals site, and computer-vision research."
  parked="FPLN"
>
  <section class="leg phase-cruise" aria-labelledby="h-title" style="padding-top: 9rem">
    <div class="leg__col">
      <p class="eyebrow">Lower ECAM · system pages</p>
      <h1 class="leg__title" id="h-title" data-reveal>Hangar</h1>
      <p class="leg__lead">
        Seven things I've built, drawn the way an aircraft draws its own systems: what goes in, what happens to it,
        and what comes out. Press a demo where there is one. Every figure on these pages comes from the project
        itself — its README, its benchmark run, or its package index — and says where.
      </p>
    </div>

    <div class="ecam" data-ecam>
      <svg class="syn-defs" aria-hidden="true" focusable="false" set:html={defs()} />
      <!-- STATUS -->
      <article class="ecam__pg is-on" id="sys-status" role="tabpanel" aria-labelledby="tab-status" tabindex="0">
        <div class="ecam__hd">
          <span class="ecam__id">STATUS</span>
          <h2 class="ecam__nm">Fleet</h2>
          <p class="ecam__sum">Seven systems. Four are shipped and reachable; three are research you can read.</p>
        </div>
        <table class="stat">
          <caption>Select a system below, or press its ident on the control row</caption>
          <thead>
            <tr>
              <th scope="col">IDENT</th>
              <th scope="col">SYSTEM</th>
              <th scope="col">DOES</th>
              <th scope="col">STATE</th>
            </tr>
          </thead>
          <tbody>
            {
              systems.map((s) => (
                <tr>
                  <td>
                    <a class="stat__go" href={`#sys-${s.slug}`} data-ecam-link={s.slug}>
                      {s.ident}
                    </a>
                  </td>
                  <td>{s.name}</td>
                  <td>{s.summary}</td>
                  <td>
                    <span class="stat__s" data-s={s.state}>
                      {stateLabel[s.state]}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </article>

      {
        systems.map((s) => {
          const syn = synoptics[s.slug];
          /* a synoptic-only page has no demo panel, so the prose runs under the drawing */
          const wide = s.demo.kind === 'synoptic';
          return (
            <article class="ecam__pg" id={`sys-${s.slug}`} role="tabpanel" aria-labelledby={`tab-${s.slug}`} tabindex="0">
              <div class="ecam__hd">
                <span class="ecam__id">{s.ident}</span>
                <h2 class="ecam__nm">{s.name}</h2>
                <span class="ecam__st" data-s={s.state}>
                  {stateLabel[s.state]}
                </span>
                <p class="ecam__sum">{s.summary}</p>
              </div>

              <div class="ecam__body">
                <div class="syn-wrap">
                  <svg viewBox="0 0 640 360" role="img" aria-label={`${s.name}: how it works`} set:html={`<title>${s.name}: how it works</title><desc>${syn.desc}</desc>${syn.svg}`} />
                </div>
                <p class="syn-hint" aria-hidden="true">drag the drawing sideways to see all of it →</p>
                {wide && <p class="syn-cap">{s.demo.caption}</p>}

                <div class={`ecam__split${wide ? ' is-wide' : ''}`}>
                  {!wide && (
                    <div>
                      {s.demo.kind === 'console' && (
                        <div class="demo demo--term">
                          <pre>{s.demo.lines.map((l) => <span class={lineClass(l)}>{l}</span>)}</pre>
                        </div>
                      )}

                      {s.demo.kind === 'embed' && (
                        <div class="demo" data-embed-host>
                          <button class="demo__load" type="button" data-embed={s.demo.url} aria-label={`Load the live site, ${s.demo.url}`}>
                            {shot(s.demo.poster) && (
                              <Image src={shot(s.demo.poster)!} alt="" widths={[420, 840]} sizes="(min-width: 58rem) 30rem, 92vw" loading="lazy" />
                            )}
                            <span class="demo__play">
                              <b>▶ LOAD THE LIVE SITE</b>
                              <span>dager23.github.io — loads only when you press</span>
                            </span>
                          </button>
                        </div>
                      )}

                      {s.demo.kind === 'shots' && (
                        <div class="demo" data-shots>
                          {s.demo.shots.map((sh, i) =>
                            shot(sh.file) ? (
                              <figure class="demo__shot" data-shot-i={i} hidden={i > 0}>
                                <Image src={shot(sh.file)!} alt={sh.caption} widths={[420, 840]} sizes="(min-width: 58rem) 30rem, 92vw" loading="lazy" />
                              </figure>
                            ) : null
                          )}
                          <div class="demo__thumbs" role="group" aria-label="Screenshots">
                            {s.demo.shots.map((sh, i) =>
                              shot(sh.file) ? (
                                <button type="button" data-thumb={i} aria-current={i === 0 ? 'true' : 'false'} title={sh.caption}>
                                  <Image src={shot(sh.file)!} alt={sh.caption} widths={[140]} sizes="4.4rem" loading="lazy" />
                                </button>
                              ) : null
                            )}
                          </div>
                        </div>
                      )}

                      <p class="demo__cap" data-shot-cap>
                        {s.demo.kind === 'shots' ? s.demo.shots[0]?.caption : s.demo.caption}
                      </p>
                    </div>
                  )}

                  <div class="ecam__prose">
                    {s.body.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </div>
              </div>

              <dl class="ecam__rd">
                {s.readouts.map((r) => (
                  <div class="ecam__row" data-tone={r.tone ?? 'normal'}>
                    <dt class="ecam__k">{r.k}</dt>
                    <dd class="ecam__v">
                      {r.v}
                      {r.source && <small class="ecam__src">source: {r.source}</small>}
                    </dd>
                  </div>
                ))}
              </dl>

              <div class="ecam__ft">
                <ul class="ecam__stack">
                  {s.stack.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                <div class="ecam__links">
                  {s.links.map((l) => (
                    <a
                      href={l.href}
                      data-primary={l.primary ? '' : undefined}
                      target={l.href.startsWith('/') ? undefined : '_blank'}
                      rel={l.href.startsWith('/') ? undefined : 'noopener'}
                    >
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }

      <div class="ecam__ctl" role="tablist" aria-label="System pages">
        {
          tabs.map((t, i) => (
            <button
              class="ecam__btn"
              type="button"
              role="tab"
              id={`tab-${t.slug}`}
              data-sys={t.slug}
              aria-controls={`sys-${t.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.ident}
            </button>
          ))
        }
      </div>
    </div>

    <p class="leg__lead ecam__note">
      Everything else — coursework, experiments and older notebooks — is on <a
        href="https://github.com/dager23"
        target="_blank"
        rel="noopener">GitHub</a
      >.
    </p>
  </section>
</Strato>

<script>
  import '../../scripts/hangar';
</script>
