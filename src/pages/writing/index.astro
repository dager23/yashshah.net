---
import { getCollection } from 'astro:content';
import Strato from '../../layouts/Strato.astro';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Strato
  path="/writing"
  title="Writing"
  description="Notes on machine-learning systems, computer vision, and the engineering around them."
  parked="NOTES"
>
  <section class="leg phase-cruise" aria-labelledby="w-title" style="padding-top: 9rem; min-height: 80svh">
    <div class="leg__col">
      <p class="eyebrow">Flight notes</p>
      <h1 class="leg__title" id="w-title">Writing</h1>
      {
        posts.length === 0 ? (
          <p class="leg__lead">Nothing published yet.</p>
        ) : (
          <ol class="logbook" role="list">
            {posts.map((post) => (
              <li class="entry">
                <p class="entry__when mono">{fmt(post.data.pubDate)}</p>
                <div>
                  <h2 style="font-size: var(--t-lead); font-weight: 600; font-stretch: 112%">
                    <a href={`/writing/${post.id}`}>{post.data.title}</a>
                  </h2>
                  <p style="margin-top: .5rem; color: var(--ink-2)">{post.data.description}</p>
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Strato>
