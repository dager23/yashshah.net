---
import { getCollection, render } from 'astro:content';
import Strato from '../../layouts/Strato.astro';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate } = entry.data;
---

<Strato path={`/writing/${entry.id}`} title={title} description={description} parked="NOTES">
  <article class="leg phase-cruise case" aria-labelledby="post-title">
    <div class="leg__col">
      <a class="case__back mono" href="/writing"><Fragment set:html={arrowLeft} /> Writing</a>
      <p class="eyebrow" style="margin-top: 2.5rem">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      </p>
      <h1 class="leg__title" id="post-title" data-reveal>{title}</h1>
      <p class="leg__lead">{description}</p>
      <div class="case__body"><Content /></div>
    </div>
  </article>
</Strato>
