---
import { getCollection } from 'astro:content';
import Strato from '../layouts/Strato.astro';
import FlightDeck from '../components/strato/FlightDeck.astro';
import { site, links, profileLinks, type ProfileLink } from '../data/site';
import { experience, type Role } from '../data/experience';
import { achievements } from '../data/achievements';
import { education } from '../data/education';
import { publications } from '../data/publications';
import { toolkit } from '../data/toolkit';
import { idents, route, mapWindow, codeFor } from '../data/flightplan';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';

// waypoints fly in chronological order
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

/** First paragraph under "## Result" in the case study, or null (leave the gap). */
function resultOf(body = ''): string | null {
  const m = body.match(/##\s*Result\s*\n+([\s\S]*?)(?=\n##\s|$)/);
  const text = m?.[1].replace(/[*_]/g, '').replace(/\s+/g, ' ').trim();
  return text || null;
}

function dateRange(r: Role): string {
  if (r.current) return r.start ? `${r.start} – now` : 'Current';
  if (r.start && r.end) return `${r.start} – ${r.end}`;
  return r.start ?? '';
}

// great-circle route, projected onto the equirectangular crop in route-region.webp
const rad = Math.PI / 180;
const project = (lon: number, lat: number) => [
  ((lon - mapWindow.lonMin) / (mapWindow.lonMax - mapWindow.lonMin)) * mapWindow.width,
  ((mapWindow.latMax - lat) / (mapWindow.latMax - mapWindow.latMin)) * mapWindow.height,
];
const toVec = (lon: number, lat: number) => [
  Math.cos(lat * rad) * Math.cos(lon * rad),
  Math.cos(lat * rad) * Math.sin(lon * rad),
  Math.sin(lat * rad),
];
function arc(a: (typeof route)[number], b: (typeof route)[number], n = 48): string {
  const A = toVec(a.lon, a.lat), B = toVec(b.lon, b.lat);
  const d = Math.acos(Math.min(1, A[0] * B[0] + A[1] * B[1] + A[2] * B[2]));
  const pts: string[] = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n, s = Math.sin(d);
    const k1 = Math.sin((1 - t) * d) / s, k2 = Math.sin(t * d) / s;
    const v = [0, 1, 2].map((j) => k1 * A[j] + k2 * B[j]);
    const [x, y] = project(Math.atan2(v[1], v[0]) / rad, Math.atan2(v[2], Math.hypot(v[0], v[1])) / rad);
    pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return `M ${pts.join(' L ')}`;
}
const legs = route.slice(1).map((c, i) => arc(route[i], c));
const cities = route.map((c) => ({ ...c, xy: project(c.lon, c.lat) }));

const paper = publications.find((p) => p.kind === 'paper');
const patent = publications.find((p) => p.kind === 'patent');
const edu = education[0];

// the contact channel: email once forwarding is live (site.ts), LinkedIn until then
const contact: ProfileLink = links.email.enabled ? links.email : links.linkedin;
const contactVia = links.email.enabled ? 'Email' : 'LinkedIn';
const otherLinks = profileLinks.filter((l) => l !== links.resume && l !== contact);
---

<Strato path="/">
  <!-- 1 · GATE / TAKEOFF ─────────────────────────────────────────── -->
  <FlightDeck name={site.name} pitch={site.intro[1]} />

  <div class="spacer" data-leg="takeoff" aria-hidden="true" style="height: 100vh"></div>

  <!-- 2 · CLIMB — about + toolkit ─────────────────────────────────── -->
  <section class="leg phase-cruise" data-leg="climb" id="about" aria-labelledby="about-title">
    <div class="leg__col">
      <p class="eyebrow">Climb · <b>ALT 10,000 FT</b></p>
      <h2 class="leg__title" id="about-title" data-reveal>About</h2>
      <p class="leg__lead" data-reveal>{site.tagline}</p>
      <p class="aside">
        <svg viewBox="-26 -20 52 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle r="7" /><path d="M-7 0H-24M7 0H24M0-7V-17" /></svg>
        Apparently likes planes enough to build an entire portfolio around them.
      </p>
      <dl class="facts mono">
        <div><dt>Role</dt><dd>{site.role}</dd></div>
        <div><dt>Base</dt><dd>{site.location}</dd></div>
        <div><dt>Education</dt><dd>{edu.degree}, {edu.school} · {edu.start}–{edu.end}{edu.note && ` · ${edu.note}`}</dd></div>
      </dl>

      <p class="eyebrow" style="margin-top: 5rem">Overhead panel · all systems on</p>
      <h2 class="leg__title" data-reveal>Toolkit</h2>
      <div class="overhead">
        {
          toolkit.map((g) => (
            <section class="panelset" aria-label={g.label}>
              <h3><span>{g.label}</span><span class="panelset__count mono">{g.items.length} on</span></h3>
              <ul>
                {g.items.map((item) => (
                  <li><i class="sw" aria-hidden="true"></i><span>{item}</span><b class="led" aria-hidden="true"></b></li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <div class="spacer" data-leg="mach" aria-hidden="true" style="height: 45vh"></div>

  <!-- 3–4 · MACH 1 + CRUISE — projects as waypoints ───────────────── -->
  <section class="leg phase-cruise" data-leg="cruise" id="waypoints" aria-labelledby="wpt-title">
    <div class="leg__col">
      <p class="eyebrow">Cruise · <b>ALT 60,000 FT</b></p>
      <h2 class="leg__title" id="wpt-title" data-reveal>Projects</h2>
    </div>
    {
      projects.map((p) => {
        const ident = idents[p.id] ?? p.id.slice(0, 5).toUpperCase();
        const result = resultOf(p.body);
        return (
          <article class="wpt" data-wpt={ident} id={`wpt-${p.id}`} aria-labelledby={`t-${p.id}`}>
            <span class="wpt__star" aria-hidden="true"></span>
            <div class="panel brackets">
              <p class="panel__hdr mono">
                <b data-tick>{ident}</b>
                <span>{p.data.date.getFullYear()}</span>
                <span>{p.data.stack.slice(0, 2).join(' · ')}</span>
              </p>
              <h3 id={`t-${p.id}`}>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              {result && (
                <div class="panel__result">
                  <span class="mono">Result</span>
                  {result}
                </div>
              )}
              <ul class="tags mono" aria-label="Stack">
                {p.data.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <a class="panel__link mono" href={`/projects/${p.id}`}>
                Open case study <Fragment set:html={arrowRight} />
              </a>
            </div>
          </article>
        );
      })
    }
  </section>

  <!-- 5 · FLIGHT LOG — experience + route ──────────────────────────── -->
  <section class="leg phase-cruise" data-leg="descent" id="log" aria-labelledby="log-title">
    <div class="log">
      <div class="leg__col">
        <p class="eyebrow">Flight log · <b>ALT 40,000 FT</b></p>
        <h2 class="leg__title" id="log-title" data-reveal>Experience</h2>
        <ol class="logbook" role="list">
          {
            experience.map((r) => {
              const code = codeFor(r.location); // lights this role's leg on the map as it scrolls past
              return (
                <li class="entry" data-code={code}>
                  <p class="entry__when mono">
                    {dateRange(r)}
                    {code && <span class="chip">{code}</span>}
                  </p>
                  <div>
                    <h3>
                      {r.title}, {r.company}
                      <small>{r.location}</small>
                    </h3>
                    {r.bullets.length > 0 && (
                      <ul>
                        {r.bullets.map((b) => (
                          <li>{b}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
      <figure class="routemap" data-reveal-fig>
        <img src="/textures/route-region.webp" width="1600" height="700" alt="" loading="lazy" decoding="async" />
        <svg viewBox="0 0 1600 700" role="img" aria-label={`Route: ${route.map((c) => c.name).join(' to ')}`}>
          {legs.map((d, i) => <path class="route-arc" d={d} data-to={route[i + 1].code} />)}
          {
            cities.map((c) => (
              <g class="route-city" data-code={c.code} transform={`translate(${c.xy[0].toFixed(1)} ${c.xy[1].toFixed(1)})`}>
                <circle class="route-city__ping" r="6" />
                <circle r="6" />
                <text x={c.label.dx} y={c.label.dy} text-anchor={c.label.anchor}>{c.code} · {c.name.toUpperCase()}</text>
              </g>
            ))
          }
          <g class="route-plane" aria-hidden="true">
            <path transform="scale(1.7)" d="M18 0 L13 -1.2 L5.5 -1.8 Q-3 -5 -12 -13 L-13.5 -12.5 L-13.2 -3 L-16.5 -1.5 L-18 0 L-16.5 1.5 L-13.2 3 L-13.5 12.5 L-12 13 Q-3 5 5.5 1.8 L13 1.2 Z" fill="var(--ink-light)" stroke="var(--instr)" stroke-width="1" />
          </g>
        </svg>
        <figcaption class="mono">Great-circle route · places in the log, in order</figcaption>
      </figure>
    </div>
  </section>

  <!-- 6 · CLEARANCES — honours + publications ─────────────────────── -->
  <section class="leg phase-cruise" data-leg="descent" id="clearances" aria-labelledby="clr-title">
    <div class="leg__col">
      <p class="eyebrow">Clearances · <b>ALT 20,000 FT</b></p>
      <h2 class="leg__title" id="clr-title" data-reveal>Honours &amp; publications</h2>
    </div>
    <ul class="stamps" style="width: min(64rem, 100%)">
      {
        achievements.map((a) => (
          <li class="stamp">
            {a.year && <span class="stamp__when mono">{a.year}</span>}
            <b>{a.title}</b>
            {a.detail && <small>{a.detail}</small>}
          </li>
        ))
      }
    </ul>
    <div class="slips leg__col">
      {
        paper && (
          <article class="slip brackets">
            <span class="mono" style="color: var(--instr)">Paper · {paper.year}</span>
            <b>{paper.title}</b>
            <p>{paper.authors} — {paper.venue}</p>
            {paper.href && <p class="mono"><a href={paper.href} rel="noopener">{paper.ref}</a></p>}
          </article>
        )
      }
      {
        patent && (
          <article class="slip brackets">
            <span class="mono" style="color: var(--instr)">Patent · {patent.year}</span>
            <b>{patent.title}</b>
            <p>{patent.venue}{patent.ref && ` — ${patent.ref}`}</p>
          </article>
        )
      }
    </div>
  </section>

  <!-- 7 · LANDING — approaching destination ───────────────────────── -->
  <section class="leg land phase-dusk" data-leg="landing" id="contact" aria-labelledby="land-title">
    <div class="leg__col">
      <p class="eyebrow">Approaching destination · <b>ALT 0 FT</b></p>
      <h2 class="leg__title" id="land-title" data-reveal>{site.name}</h2>
      <p class="land__status mono">Contact channel available · {contactVia}</p>
      <div class="contact">
        <a class="btn btn--hud" href={contact.href} rel={contact.external ? 'noopener' : undefined}>
          <b>[</b> Initiate contact <Fragment set:html={arrowUpRight} /> <b>]</b>
        </a>
        {
          otherLinks.map((l) => (
            <a class="btn" href={l.href} rel={l.external ? 'noopener' : undefined}>
              {l.label} <Fragment set:html={arrowUpRight} />
            </a>
          ))
        }
      </div>
      <a class="pass" href={links.resume.href} aria-label="Open the résumé (PDF)">
        <div class="pass__main">
          <div><span class="mono">Passenger</span><strong>{site.name.toUpperCase().split(' ').reverse().join(' / ')}</strong></div>
          <div><span class="mono">Role</span><strong>{site.role}</strong></div>
          <div><span class="mono">Base</span><strong>{site.location}</strong></div>
          <div><span class="mono">Document</span><strong>Résumé · PDF</strong></div>
        </div>
        <div class="pass__stub" aria-hidden="true"></div>
        <span class="pass__cta mono">Open boarding pass ↗</span>
      </a>
    </div>
    <div class="runway" aria-hidden="true"></div>
  </section>
</Strato>
