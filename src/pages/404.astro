---
import Strato from '../layouts/Strato.astro';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
---

<Strato path="/404" title="Page not found" description="That page doesn't exist." parked="NOWPT">
  <section class="leg phase-cruise" aria-labelledby="nf" style="min-height: 100svh; display: grid; align-content: center">
    <div class="leg__col">
      <p class="eyebrow">Off course · no such waypoint</p>
      <h1 class="leg__title" id="nf">Page not found</h1>
      <p class="leg__lead">The page you asked for doesn't exist — it may have moved, or never did.</p>
      <p style="margin-top: 2rem">
        <a class="btn btn--primary" href="/"><Fragment set:html={arrowLeft} /> Back to the gate</a>
      </p>
    </div>
  </section>
</Strato>
