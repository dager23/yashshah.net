---
import { getCollection, render } from 'astro:content';
import Strato from '../../layouts/Strato.astro';
import { idents } from '../../data/flightplan';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, role, stack, repo, demo, date } = entry.data;
const ident = idents[entry.id] ?? entry.id.slice(0, 5).toUpperCase();
---

<Strato path={`/projects/${entry.id}`} title={title} description={summary} parked={ident}>
  <article class="leg phase-cruise case" aria-labelledby="case-title">
    <div class="leg__col">
      <a class="case__back mono" href={`/#wpt-${entry.id}`}><Fragment set:html={arrowLeft} /> Flight plan</a>
      <p class="eyebrow" style="margin-top: 2.5rem">Waypoint {ident} · {date.getFullYear()}</p>
      <h1 class="leg__title" id="case-title" data-reveal>{title}</h1>
      <p class="leg__lead" data-reveal>{summary}</p>

      <div class="panel brackets is-docked case__meta">
        <p class="panel__hdr mono"><b>{ident}</b><span>{role}</span></p>
        <ul class="tags mono" aria-label="Stack">{stack.map((s) => <li>{s}</li>)}</ul>
        {
          (repo || demo) && (
            <p class="case__links">
              {repo && <a class="btn" href={repo} rel="noopener">Repository <Fragment set:html={arrowUpRight} /></a>}
              {demo && <a class="btn" href={demo} rel="noopener">Live demo <Fragment set:html={arrowUpRight} /></a>}
            </p>
          )
        }
      </div>

      <div class="case__body">
        <Content />
      </div>
    </div>
  </article>
</Strato>
