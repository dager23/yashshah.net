---
import { getCollection } from 'astro:content';
import Strato from '../../layouts/Strato.astro';
import { idents } from '../../data/flightplan';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);
---

<Strato
  path="/projects"
  title="Projects"
  description="Case studies — computer vision, document forensics, and NLP systems by Yash Shah."
  parked="FPLN"
>
  <section class="leg phase-cruise" aria-labelledby="p-title" style="padding-top: 9rem">
    <div class="leg__col">
      <p class="eyebrow">Flight plan · all waypoints</p>
      <h1 class="leg__title" id="p-title" data-reveal>Projects</h1>
      <p class="leg__lead">Each case study follows the same shape: the problem, what I built, the decision that mattered, and the result.</p>
    </div>
    <div class="case-list">
      {
        projects.map((p) => {
          const ident = idents[p.id] ?? p.id.slice(0, 5).toUpperCase();
          return (
            <a class="panel brackets is-docked case-list__item" href={`/projects/${p.id}`}>
              <p class="panel__hdr mono">
                <b data-tick>{ident}</b>
                <span>{p.data.date.getFullYear()}</span>
                <span>{p.data.role}</span>
              </p>
              <h2>{p.data.title}</h2>
              <p>{p.data.summary}</p>
              <span class="panel__link mono">Open case study <Fragment set:html={arrowRight} /></span>
            </a>
          );
        })
      }
    </div>
  </section>
</Strato>
